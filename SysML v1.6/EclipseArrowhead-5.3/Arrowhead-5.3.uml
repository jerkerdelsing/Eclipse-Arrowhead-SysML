        <packagedElement xmi:id="_ah53_7d05a2bb6c02bebafc4bcc36" name="sysMonitor_SD" xmi:type="uml:Class" />
        <packagedElement xmi:id="_ah53_5ffd1219b712b6602c19244c" name="sysMonitor_AMQP_IDD" xmi:type="uml:Class">
          <generalization xmi:id="_ah53_fcea20fe2761e959f5a24fe3" general="_ah53_7d05a2bb6c02bebafc4bcc36" xmi:type="uml:Generalization" />
          <ownedComment xmi:id="_ah53_53a7db18fd9c7b95a08421e7" xmi:type="uml:Comment">
            <body>Source: ah5-GraphDBManager-java-spring/documentation/v5.3.0/GraphDBManager-v5.3.0-sysMonitor-AMQP-IDD.tex; With sysmonitor.enabled=true, GraphDBManager registers the service at start-up with interface template generic_amqps (protocol amqps, policy CERT_AUTH; generic_amqp without TLS) and the following properties and metadata:

\begin{lstlisting}[caption={Registered service instance (TestCloud).}]
{
  "serviceDefinitionName": "sysMonitor",
  "version": "1.0.0",
  "metadata": {
    "contract": "SysMonitor-AMQP-IDD-5.2.2",
    "schemaVersion": "1.0",
    "publisherMode": "native",
    "observationTypes": [
      "echo",
      "power",
      "status"
    ],
    "delivery": "persistent, publisher-confirmed"
  },
  "interfaces": [
    {
      "templateName": "generic_amqps",
      "protocol": "amqps",
      "policy": "CERT_AUTH",
      "properties": {
        "accessAddresses": [
          "amqp-broker"
        ],
        "accessPort": 5671,
        "exchange": "arrowhead",
        "baseRoutingKey": "TestCloud.sysmonitor.GraphDBManager.GraphDBManager",
        "operations": [
          "echo",
          "power",
          "status"
        ]
      }
    }
  ]
}
\end{lstlisting}</body>
          </ownedComment>

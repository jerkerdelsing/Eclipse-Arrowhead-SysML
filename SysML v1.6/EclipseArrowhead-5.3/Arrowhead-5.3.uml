        <packagedElement xmi:id="_ah53_1fe94a2bcca2c37a47bff823" name="sysMonitor_SD" xmi:type="uml:Class" />
        <packagedElement xmi:id="_ah53_5ef10395124052c7ba8e0c27" name="sysMonitor_AMQP_IDD" xmi:type="uml:Class">
          <generalization xmi:id="_ah53_da883b8ce2069de53b471e62" general="_ah53_1fe94a2bcca2c37a47bff823" xmi:type="uml:Generalization" />
          <ownedComment xmi:id="_ah53_fa83f9b4bf2db039c36f1689" xmi:type="uml:Comment">
            <body>Source: ah5-CertificateAuthority-java-spring/documentation/v5.3.0/CertificateAuthority-v5.3.0-sysMonitor-AMQP-IDD.tex; With sysmonitor.enabled=true, CertificateAuthority registers the service at start-up with interface template generic_amqps (protocol amqps, policy CERT_AUTH; generic_amqp without TLS) and the following properties and metadata:

\begin{lstlisting}[caption={Registered service instance (TestCloud).}]
{
  "serviceDefinitionName": "sysMonitor",
  "version": "1.0.0",
  "metadata": {
    "contract": "SysMonitor-AMQP-IDD-5.2.2",
    "schemaVersion": "1.0",
    "publisherMode": "native",
    "observationTypes": [
      "echo",
      "power",
      "status"
    ],
    "delivery": "persistent, publisher-confirmed"
  },
  "interfaces": [
    {
      "templateName": "generic_amqps",
      "protocol": "amqps",
      "policy": "CERT_AUTH",
      "properties": {
        "accessAddresses": [
          "amqp-broker"
        ],
        "accessPort": 5671,
        "exchange": "arrowhead",
        "baseRoutingKey": "TestCloud.sysmonitor.CertificateAuthority.CertificateAuthority",
        "operations": [
          "echo",
          "power",
          "status"
        ]
      }
    }
  ]
}
\end{lstlisting}</body>
          </ownedComment>

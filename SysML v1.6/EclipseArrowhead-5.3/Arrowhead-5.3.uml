        <packagedElement xmi:id="_ah53_f5878fda6929e6b46fd9e632" name="sysMonitor_SD" xmi:type="uml:Class" />
        <packagedElement xmi:id="_ah53_e57d2a903c34bbd883e40c39" name="sysMonitor_AMQP_IDD" xmi:type="uml:Class">
          <generalization xmi:id="_ah53_99f8a726137f69e279350489" general="_ah53_f5878fda6929e6b46fd9e632" xmi:type="uml:Generalization" />
          <ownedComment xmi:id="_ah53_9baac24a152b04f41c280414" xmi:type="uml:Comment">
            <body>Source: ah5-PlantDescriptionEngine-java-spring/documentation/v5.3.0/PlantDescriptionEngine-v5.3.0-sysMonitor-AMQP-IDD.tex; With sysmonitor.enabled=true, PlantDescriptionEngine registers the service at start-up with interface template generic_amqps (protocol amqps, policy CERT_AUTH; generic_amqp without TLS) and the following properties and metadata:

\begin{lstlisting}[caption={Registered service instance (TestCloud).}]
{
  "serviceDefinitionName": "sysMonitor",
  "version": "1.0.0",
  "metadata": {
    "contract": "SysMonitor-AMQP-IDD-5.2.2",
    "schemaVersion": "1.0",
    "publisherMode": "native",
    "observationTypes": [
      "echo",
      "power",
      "status"
    ],
    "delivery": "persistent, publisher-confirmed"
  },
  "interfaces": [
    {
      "templateName": "generic_amqps",
      "protocol": "amqps",
      "policy": "CERT_AUTH",
      "properties": {
        "accessAddresses": [
          "amqp-broker"
        ],
        "accessPort": 5671,
        "exchange": "arrowhead",
        "baseRoutingKey": "TestCloud.sysmonitor.PlantDescriptionEngine.PlantDescriptionEngine",
        "operations": [
          "echo",
          "power",
          "status"
        ]
      }
    }
  ]
}
\end{lstlisting}</body>
          </ownedComment>
          <ownedOperation xmi:id="_ah53_17a778557c1be84946e03eb3" name="echo" xmi:type="uml:Operation">
            <ownedComment xmi:id="_ah53_9318a895118e3c06c321f6eb" xmi:type="uml:Comment">
              <body>{"protocol": "amqp", "method": "PUBLISH", "address": "&lt;Cloud&gt;.sysmonitor.PlantDescriptionEngine.PlantDescriptionEngine.echo", "source": "ah5-PlantDescriptionEngine-java-spring/documentation/v5.3.0/PlantDescriptionEngine-v5.3.0-sysMonitor-AMQP-IDD.tex", "query": [], "path": [], "status": []}</body>
            </ownedComment>

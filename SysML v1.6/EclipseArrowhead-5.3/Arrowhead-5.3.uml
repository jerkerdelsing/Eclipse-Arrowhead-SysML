        <packagedElement xmi:id="_ah53_eceea3555875467020a6898e" name="sysMonitor_SD" xmi:type="uml:Class" />
        <packagedElement xmi:id="_ah53_0d352e22ba066d8a9c2e7887" name="sysMonitor_AMQP_IDD" xmi:type="uml:Class">
          <generalization xmi:id="_ah53_853111d6fcc69afc7afdf7a7" general="_ah53_eceea3555875467020a6898e" xmi:type="uml:Generalization" />
          <ownedComment xmi:id="_ah53_df8cd55d80952a64e0d5159f" xmi:type="uml:Comment">
            <body>Source: ah5-core-java-spring/consumer-authorization/documentation/v5.3.0/ConsumerAuthorization-v5.3.0-sysMonitor-AMQP-IDD.tex; With sysmonitor.enabled=true, ConsumerAuthorization registers the service at start-up with interface template generic_amqps (protocol amqps, policy CERT_AUTH; generic_amqp without TLS) and the following properties and metadata:

\begin{lstlisting}[caption={Registered service instance (TestCloud).}]
{
  "serviceDefinitionName": "sysMonitor",
  "version": "1.0.0",
  "metadata": {
    "contract": "SysMonitor-AMQP-IDD-5.2.2",
    "schemaVersion": "1.0",
    "publisherMode": "native",
    "observationTypes": [
      "echo",
      "power",
      "status"
    ],
    "delivery": "persistent, publisher-confirmed"
  },
  "interfaces": [
    {
      "templateName": "generic_amqps",
      "protocol": "amqps",
      "policy": "CERT_AUTH",
      "properties": {
        "accessAddresses": [
          "amqp-broker"
        ],
        "accessPort": 5671,
        "exchange": "arrowhead",
        "baseRoutingKey": "TestCloud.sysmonitor.ConsumerAuthorization.ConsumerAuthorization",
        "operations": [
          "echo",
          "power",
          "status"
        ]
      }
    }
  ]
}
\end{lstlisting}</body>
          </ownedComment>

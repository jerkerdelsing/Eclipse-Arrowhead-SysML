        <packagedElement xmi:id="_ah53_f096d0f0027a6bcfbbb2d3b5" name="sysMonitor_SD" xmi:type="uml:Class" />
        <packagedElement xmi:id="_ah53_d544ee3ac179aba00373a65d" name="sysMonitor_AMQP_IDD" xmi:type="uml:Class">
          <generalization xmi:id="_ah53_ff9fb0fb83be143d9182d60e" general="_ah53_f096d0f0027a6bcfbbb2d3b5" xmi:type="uml:Generalization" />
          <ownedComment xmi:id="_ah53_d88343a6bbfc98d4403dd8ee" xmi:type="uml:Comment">
            <body>Source: ah5-GateTunnel-java-spring/documentation/v5.3.0/GateTunnel-v5.3.0-sysMonitor-AMQP-IDD.tex; With sysmonitor.enabled=true, GateTunnel registers the service at start-up with interface template generic_amqps (protocol amqps, policy CERT_AUTH; generic_amqp without TLS) and the following properties and metadata:

\begin{lstlisting}[caption={Registered service instance (TestCloud).}]
{
  "serviceDefinitionName": "sysMonitor",
  "version": "1.0.0",
  "metadata": {
    "contract": "SysMonitor-AMQP-IDD-5.2.2",
    "schemaVersion": "1.0",
    "publisherMode": "native",
    "observationTypes": [
      "echo",
      "power",
      "status"
    ],
    "delivery": "persistent, publisher-confirmed"
  },
  "interfaces": [
    {
      "templateName": "generic_amqps",
      "protocol": "amqps",
      "policy": "CERT_AUTH",
      "properties": {
        "accessAddresses": [
          "amqp-broker"
        ],
        "accessPort": 5671,
        "exchange": "arrowhead",
        "baseRoutingKey": "TestCloud.sysmonitor.GateTunnel.GateTunnel",
        "operations": [
          "echo",
          "power",
          "status"
        ]
      }
    }
  ]
}
\end{lstlisting}</body>
          </ownedComment>

device-create &amp; POST &amp; /devices \\ \hline
device-update &amp; PUT &amp; /devices \\ \hline
device-remove &amp; DELETE &amp; /devices \\ \hline
system-query &amp; POST &amp; /systems/query \\ \hline
system-create &amp; POST &amp; /systems \\ \hline
system-update &amp; PUT &amp; /systems \\ \hline
system-remove &amp; DELETE &amp; /systems \\ \hline
service-definition-query &amp; POST &amp; /service-definitions/query \\ \hline
service-definition-create &amp; POST &amp; /service-definitions \\ \hline
service-definition-remove &amp; DELETE &amp; /service-definitions \\ \hline

              <lowerValue xmi:id="_ah53_1c852a37884ea0005cdd1fde" value="0" xmi:type="uml:LiteralInteger" />
            </ownedParameter>
            <ownedParameter xmi:id="_ah53_bcd2b4a8d5bc47e6179f40bb" name="response" direction="return" xmi:type="uml:Parameter" type="_ah53_a82bfb75acfd9747eac2108a">
              <lowerValue xmi:id="_ah53_edca793322981dc825328a68" value="0" xmi:type="uml:LiteralInteger" />
            </ownedParameter>
          </ownedOperation>
          <ownedOperation xmi:id="_ah53_0baf65245da66e3c987cce08" name="abort-session" xmi:type="uml:Operation">
            <ownedComment xmi:id="_ah53_ace6258ff4d85db29a65cd9d" xmi:type="uml:Comment">
              <body>{"protocol": "http", "method": "DELETE", "address": "/choreographer/session/abort/{id}", "source": "ah5-Choreographer-java-spring/src/main/java/eu/arrowhead/choreographer/api/http/SessionAPI.java", "query": [], "path": ["id"], "status": []}</body>
            </ownedComment>
          </ownedOperation>
        </packagedElement>

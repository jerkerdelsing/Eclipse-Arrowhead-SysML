        <packagedElement xmi:id="_ah53_bbaf54f8a98800c6ae7e0c4d" name="sysMonitor_SD" xmi:type="uml:Class" />
        <packagedElement xmi:id="_ah53_17c619016039d8949c6707fe" name="sysMonitor_AMQP_IDD" xmi:type="uml:Class">
          <generalization xmi:id="_ah53_832c2e7f3ce6d962ac744094" general="_ah53_bbaf54f8a98800c6ae7e0c4d" xmi:type="uml:Generalization" />
          <ownedComment xmi:id="_ah53_1234dfd0e2ef94c7457beef7" xmi:type="uml:Comment">
            <body>Source: ah5-DataManager-java-spring/documentation/v5.3.0/DataManager-v5.3.0-sysMonitor-AMQP-IDD.tex; With sysmonitor.enabled=true, DataManager registers the service at start-up with interface template generic_amqps (protocol amqps, policy CERT_AUTH; generic_amqp without TLS) and the following properties and metadata:

\begin{lstlisting}[caption={Registered service instance (TestCloud).}]
{
  "serviceDefinitionName": "sysMonitor",
  "version": "1.0.0",
  "metadata": {
    "contract": "SysMonitor-AMQP-IDD-5.2.2",
    "schemaVersion": "1.0",
    "publisherMode": "native",
    "observationTypes": [
      "echo",
      "power",
      "status"
    ],
    "delivery": "persistent, publisher-confirmed"
  },
  "interfaces": [
    {
      "templateName": "generic_amqps",
      "protocol": "amqps",
      "policy": "CERT_AUTH",
      "properties": {
        "accessAddresses": [
          "amqp-broker"
        ],
        "accessPort": 5671,
        "exchange": "arrowhead",
        "baseRoutingKey": "TestCloud.sysmonitor.DataManager.DataManager",
        "operations": [
          "echo",
          "power",
          "status"
        ]
      }
    }
  ]
}
\end{lstlisting}</body>
          </ownedComment>
          <ownedOperation xmi:id="_ah53_910d41510f13ef20589f4998" name="echo" xmi:type="uml:Operation">

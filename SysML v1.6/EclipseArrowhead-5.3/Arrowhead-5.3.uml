        <packagedElement xmi:id="_ah53_f4ae810e733f8863d4d9e33a" name="sysMonitor_SD" xmi:type="uml:Class" />
        <packagedElement xmi:id="_ah53_48ad38651c20bdb62dbccbea" name="sysMonitor_AMQP_IDD" xmi:type="uml:Class">
          <generalization xmi:id="_ah53_5bc017030fc3a576acd5f620" general="_ah53_f4ae810e733f8863d4d9e33a" xmi:type="uml:Generalization" />
          <ownedComment xmi:id="_ah53_c76bc34d868e5732baa8cda3" xmi:type="uml:Comment">
            <body>Source: ah5-TimeManager-java-spring/documentation/v5.3.0/TimeManager-v5.3.0-sysMonitor-AMQP-IDD.tex; With sysmonitor.enabled=true, TimeManager registers the service at start-up with interface template generic_amqps (protocol amqps, policy CERT_AUTH; generic_amqp without TLS) and the following properties and metadata:

\begin{lstlisting}[caption={Registered service instance (TestCloud).}]
{
  "serviceDefinitionName": "sysMonitor",
  "version": "1.0.0",
  "metadata": {
    "contract": "SysMonitor-AMQP-IDD-5.2.2",
    "schemaVersion": "1.0",
    "publisherMode": "native",
    "observationTypes": [
      "echo",
      "power",
      "status"
    ],
    "delivery": "persistent, publisher-confirmed"
  },
  "interfaces": [
    {
      "templateName": "generic_amqps",
      "protocol": "amqps",
      "policy": "CERT_AUTH",
      "properties": {
        "accessAddresses": [
          "amqp-broker"
        ],
        "accessPort": 5671,
        "exchange": "arrowhead",
        "baseRoutingKey": "TestCloud.sysmonitor.TimeManager.TimeManager",
        "operations": [
          "echo",
          "power",
          "status"
        ]
      }
    }
  ]
}
\end{lstlisting}</body>
          </ownedComment>

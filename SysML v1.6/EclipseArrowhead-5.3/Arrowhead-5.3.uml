        <packagedElement xmi:id="_ah53_6f5c2d667fc75449197a0d4d" name="sysMonitor_SD" xmi:type="uml:Class" />
        <packagedElement xmi:id="_ah53_207ec886ad30a58f0ee53e10" name="sysMonitor_AMQP_IDD" xmi:type="uml:Class">
          <generalization xmi:id="_ah53_64dd2bf4f859ec012715a421" general="_ah53_6f5c2d667fc75449197a0d4d" xmi:type="uml:Generalization" />
          <ownedComment xmi:id="_ah53_972a7c51225591aedac01afc" xmi:type="uml:Comment">
            <body>Source: ah5-Choreographer-java-spring/documentation/v5.3.0/Choreographer-v5.3.0-sysMonitor-AMQP-IDD.tex; With sysmonitor.enabled=true, Choreographer registers the service at start-up with interface template generic_amqps (protocol amqps, policy CERT_AUTH; generic_amqp without TLS) and the following properties and metadata:

\begin{lstlisting}[caption={Registered service instance (TestCloud).}]
{
  "serviceDefinitionName": "sysMonitor",
  "version": "1.0.0",
  "metadata": {
    "contract": "SysMonitor-AMQP-IDD-5.2.2",
    "schemaVersion": "1.0",
    "publisherMode": "native",
    "observationTypes": [
      "echo",
      "power",
      "status"
    ],
    "delivery": "persistent, publisher-confirmed"
  },
  "interfaces": [
    {
      "templateName": "generic_amqps",
      "protocol": "amqps",
      "policy": "CERT_AUTH",
      "properties": {
        "accessAddresses": [
          "amqp-broker"
        ],
        "accessPort": 5671,
        "exchange": "arrowhead",
        "baseRoutingKey": "TestCloud.sysmonitor.Choreographer.Choreographer",
        "operations": [
          "echo",
          "power",
          "status"
        ]
      }
    }
  ]
}
\end{lstlisting}</body>
          </ownedComment>

        <packagedElement xmi:id="_ah53_0212798326474668de93bcb9" name="certificateAuthorityManagement_SD" xmi:type="uml:Class" />
        <packagedElement xmi:id="_ah53_33ad1db82ea866704225133c" name="certificateAuthorityManagement_HTTP_IDD" xmi:type="uml:Class">
          <generalization xmi:id="_ah53_26c8a6c6dadd501a95c09800" general="_ah53_0212798326474668de93bcb9" xmi:type="uml:Generalization" />
          <ownedComment xmi:id="_ah53_af5d9d2b91a4e084a0b3c235" xmi:type="uml:Comment">
            <body>Source: ah5-CertificateAuthority-java-spring/documentation/v5.3.0/CertificateAuthority-v5.3.0-certificateAuthorityManagement-HTTP-IDD.tex; The service is registered in the ServiceRegistry with the interface template generic_https, policy CERT_AUTH, access address certificate-authority, port 8448 and base path /certificate-authority. The operations property of the interface lists the operations below with their method and path relative to the base path (path parameters are placeholders such as \texttt{{id}} that the consumer fills in):

\noindent\begin{longtable}{| p{5.2cm} | p{1.6cm} | p{8.4cm} |} \hline
\rowcolor{gray!33} Operation &amp; Method &amp; Path \\ \hline \endhead
list-certificates &amp; GET &amp; /mgmt/certificates \\ \hline
revoke-certificate &amp; DELETE &amp; \texttt{/mgmt/certificates/{id}} \\ \hline
revoke-certificate-by-content &amp; POST &amp; /mgmt/revocations \\ \hline
list-keys &amp; GET &amp; /mgmt/keys \\ \hline
add-key &amp; PUT &amp; /mgmt/keys \\ \hline
delete-key &amp; DELETE &amp; \texttt{/mgmt/keys/{id}} \\ \hline
\end{longtable}

\newpage</body>
          </ownedComment>
          <ownedOperation xmi:id="_ah53_abf2c059f456c20767137fb8" name="list-certificates" xmi:type="uml:Operation">
            <ownedComment xmi:id="_ah53_6f3d9e123bb985f8081add94" xmi:type="uml:Comment">
              <body>{"protocol": "http", "method": "GET", "address": "/certificate-authority/mgmt/certificates", "source": "ah5-CertificateAuthority-java-spring/src/main/java/eu/arrowhead/certificateauthority/api/http/CertificateAuthorityAPI.java", "query": [], "path": [], "status": []}</body>
            </ownedComment>
            <ownedParameter xmi:id="_ah53_3dc1dba5fc5a7338ca002929" name="response" direction="return" xmi:type="uml:Parameter" type="_ah53_c70852e5abc69576a1a773d2">
              <lowerValue xmi:id="_ah53_973806e4a45be9cd06aa9ae9" value="0" xmi:type="uml:LiteralInteger" />
              <upperValue xmi:id="_ah53_62647b03b0615f08007f8683" value="*" xmi:type="uml:LiteralUnlimitedNatural" />

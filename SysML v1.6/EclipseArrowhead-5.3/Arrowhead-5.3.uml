            <ownedComment xmi:id="_ah53_c16ce0d570739ce03fe2d48c" xmi:type="uml:Comment">
              <body>{"protocol": "http", "method": "GET", "address": "/api/overview", "source": "ah5-LocalCloudManager-java-spring/documentation/v5.3.0/LocalCloudManager-v5.3.0-localCloudManagement-HTTP-IDD.tex", "query": [], "path": [], "status": []}</body>

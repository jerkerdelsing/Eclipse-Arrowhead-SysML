service-create &amp; POST &amp; /service-instances \\ \hline
service-update &amp; PUT &amp; /service-instances \\ \hline
service-remove &amp; DELETE &amp; /service-instances \\ \hline
interface-template-query &amp; POST &amp; /interface-templates/query \\ \hline
interface-template-create &amp; POST &amp; /interface-templates \\ \hline
interface-template-remove &amp; DELETE &amp; /interface-templates \\ \hline
\end{longtable}


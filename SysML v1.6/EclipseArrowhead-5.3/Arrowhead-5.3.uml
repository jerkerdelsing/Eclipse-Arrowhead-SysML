        <packagedElement xmi:id="_ah53_f5278aa1c06ff724d538cbed" name="sysMonitor_SD" xmi:type="uml:Class" />
        <packagedElement xmi:id="_ah53_fb6e3afedd0e885889d3d3ab" name="sysMonitor_AMQP_IDD" xmi:type="uml:Class">
          <generalization xmi:id="_ah53_0c25bc7aec7169eb8f9a127d" general="_ah53_f5278aa1c06ff724d538cbed" xmi:type="uml:Generalization" />
          <ownedComment xmi:id="_ah53_117018898320f29390f1a889" xmi:type="uml:Comment">
            <body>Source: ah5-core-java-spring/authentication/documentation/v5.3.0/Authentication-v5.3.0-sysMonitor-AMQP-IDD.tex; With sysmonitor.enabled=true, Authentication registers the service at start-up with interface template generic_amqps (protocol amqps, policy CERT_AUTH; generic_amqp without TLS) and the following properties and metadata:

\begin{lstlisting}[caption={Registered service instance (TestCloud).}]
{
  "serviceDefinitionName": "sysMonitor",
  "version": "1.0.0",
  "metadata": {
    "contract": "SysMonitor-AMQP-IDD-5.2.2",
    "schemaVersion": "1.0",
    "publisherMode": "native",
    "observationTypes": [
      "echo",
      "power",
      "status"
    ],
    "delivery": "persistent, publisher-confirmed"
  },
  "interfaces": [
    {
      "templateName": "generic_amqps",
      "protocol": "amqps",
      "policy": "CERT_AUTH",
      "properties": {
        "accessAddresses": [
          "amqp-broker"
        ],
        "accessPort": 5671,
        "exchange": "arrowhead",
        "baseRoutingKey": "TestCloud.sysmonitor.Authentication.Authentication",
        "operations": [
          "echo",
          "power",
          "status"
        ]
      }
    }
  ]
}
\end{lstlisting}</body>
          </ownedComment>

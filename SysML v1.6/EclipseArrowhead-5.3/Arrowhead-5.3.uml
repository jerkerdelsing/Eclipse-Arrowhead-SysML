        <packagedElement xmi:id="_ah53_a8cfb0972dabc3c34d173c4a" name="sysMonitor_SD" xmi:type="uml:Class" />
        <packagedElement xmi:id="_ah53_aee2b6935230e7c4dac83792" name="sysMonitor_AMQP_IDD" xmi:type="uml:Class">
          <generalization xmi:id="_ah53_c5a014dd95c3e59afd49cf89" general="_ah53_a8cfb0972dabc3c34d173c4a" xmi:type="uml:Generalization" />
          <ownedComment xmi:id="_ah53_e4161f9afb325919848b704e" xmi:type="uml:Comment">
            <body>Source: ah5-LocalCloudManager-java-spring/documentation/v5.3.0/LocalCloudManager-v5.3.0-sysMonitor-AMQP-IDD.tex; With sysmonitor.enabled=true, the common sysMonitor publisher of LocalCloudManager registers the service at start-up with interface template generic_amqps (protocol amqps, policy CERT_AUTH; generic_amqp without TLS) and the following properties and metadata:

\begin{lstlisting}[caption={Registered service instance (TestCloud).}]
{
  "serviceDefinitionName": "sysMonitor",
  "version": "1.0.0",
  "metadata": {
    "contract": "SysMonitor-AMQP-IDD-5.2.2",
    "schemaVersion": "1.0",
    "publisherMode": "native",
    "observationTypes": [
      "echo",
      "power",
      "status"
    ],
    "delivery": "persistent, publisher-confirmed"
  },
  "interfaces": [
    {
      "templateName": "generic_amqps",
      "protocol": "amqps",
      "policy": "CERT_AUTH",
      "properties": {
        "accessAddresses": [
          "amqp-broker"
        ],
        "accessPort": 5671,
        "exchange": "arrowhead",
        "baseRoutingKey": "TestCloud.sysmonitor.LocalCloudManager.LocalCloudManager",
        "operations": [
          "echo",
          "power",
          "status"
        ]
      }
    }
  ]
}
\end{lstlisting}</body>
          </ownedComment>
          <ownedOperation xmi:id="_ah53_94e4e894e42f3989be652905" name="echo" xmi:type="uml:Operation">

          <generalization xmi:id="_ah53_1c321a865a7936c0718303e2" general="_ah53_42124c5ff950ed71440423a8" xmi:type="uml:Generalization" />
          <ownedComment xmi:id="_ah53_9f67d6da821336683e5fad90" xmi:type="uml:Comment">
            <body>Source: ah5-LocalCloudManager-java-spring/src/main/java/eu/arrowhead/localcloudmanager/LocalCloudManagerSystemInfo.java; </body>

        <packagedElement xmi:id="_ah53_85a5ff8fec9283c10eacc9f2" name="generalManagement_SD" xmi:type="uml:Class" />
        <packagedElement xmi:id="_ah53_b6999054bd5da10f61059495" name="generalManagement_HTTP_IDD" xmi:type="uml:Class">
          <generalization xmi:id="_ah53_79a95504aeecad139230ad48" general="_ah53_85a5ff8fec9283c10eacc9f2" xmi:type="uml:Generalization" />

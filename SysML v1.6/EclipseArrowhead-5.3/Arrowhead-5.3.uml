        <packagedElement xmi:id="_ah53_ee96a478ec36f2842d9aca79" name="sysMonitor_SD" xmi:type="uml:Class" />
        <packagedElement xmi:id="_ah53_e615cf0eae057bdc253ade60" name="sysMonitor_AMQP_IDD" xmi:type="uml:Class">
          <generalization xmi:id="_ah53_f2ddcce4c7d161afdf67acc0" general="_ah53_ee96a478ec36f2842d9aca79" xmi:type="uml:Generalization" />
          <ownedComment xmi:id="_ah53_f529155f1988ea12ce0912d6" xmi:type="uml:Comment">
            <body>Source: ah5-TranslationManager-java-spring/documentation/v5.3.0/TranslationManager-v5.3.0-sysMonitor-AMQP-IDD.tex; With sysmonitor.enabled=true, TranslationManager registers the service at start-up with interface template generic_amqps (protocol amqps, policy CERT_AUTH; generic_amqp without TLS) and the following properties and metadata:

\begin{lstlisting}[caption={Registered service instance (TestCloud).}]
{
  "serviceDefinitionName": "sysMonitor",
  "version": "1.0.0",
  "metadata": {
    "contract": "SysMonitor-AMQP-IDD-5.2.2",
    "schemaVersion": "1.0",
    "publisherMode": "native",
    "observationTypes": [
      "echo",
      "power",
      "status"
    ],
    "delivery": "persistent, publisher-confirmed"
  },
  "interfaces": [
    {
      "templateName": "generic_amqps",
      "protocol": "amqps",
      "policy": "CERT_AUTH",
      "properties": {
        "accessAddresses": [
          "amqp-broker"
        ],
        "accessPort": 5671,
        "exchange": "arrowhead",
        "baseRoutingKey": "TestCloud.sysmonitor.TranslationManager.TranslationManager",
        "operations": [
          "echo",
          "power",
          "status"
        ]
      }
    }
  ]
}
\end{lstlisting}</body>
          </ownedComment>

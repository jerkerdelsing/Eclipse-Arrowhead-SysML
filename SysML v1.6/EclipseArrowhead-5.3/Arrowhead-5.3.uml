          <ownedComment xmi:id="_ah53_0538c5b553e13a9359c2187c" xmi:type="uml:Comment">
            <body>Source: ah5-SysMonitor-java-spring/documentation/v5.3.0/SysMonitor-v5.3.0-sysMonitorData-MQTT-IDD.tex; \begin{lstlisting}[caption={Registered service instance (TestCloud).}]
{
  "serviceDefinitionName": "sysMonitorData",
  "version": "1.0.0",
  "metadata": {
    "contract": "SysMonitor-Data-MQTT-IDD-5.2.2",
    "schemaVersion": "1.0"
  },
  "interfaces": [
    {
      "templateName": "generic_mqtts",
      "protocol": "ssl",
      "policy": "CERT_AUTH",
      "properties": {
        "accessAddresses": [
          "mqtt-broker"
        ],
        "accessPort": 8883,
        "baseTopic": "arrowhead/TestCloud/sysmonitor/data",
        "operations": [
          "subscribe"
        ]
      }
    }
  ]
}
\end{lstlisting}</body>
          </ownedComment>

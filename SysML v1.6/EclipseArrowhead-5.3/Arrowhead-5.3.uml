              <body>{"protocol": "amqp", "method": "PUBLISH", "address": "&lt;Cloud&gt;.sysmonitor.DataManager.DataManager.echo", "source": "ah5-DataManager-java-spring/documentation/v5.3.0/DataManager-v5.3.0-sysMonitor-AMQP-IDD.tex", "query": [], "path": [], "status": []}</body>

              <body>{"protocol": "amqp", "method": "PUBLISH", "address": "&lt;Cloud&gt;.sysmonitor.LocalCloudManager.LocalCloudManager.echo", "source": "ah5-LocalCloudManager-java-spring/documentation/v5.3.0/LocalCloudManager-v5.3.0-sysMonitor-AMQP-IDD.tex", "query": [], "path": [], "status": []}</body>

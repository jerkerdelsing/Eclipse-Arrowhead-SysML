        <packagedElement xmi:id="_ah53_e00d9088e2958ba26d766d9a" name="sysMonitor_SD" xmi:type="uml:Class" />
        <packagedElement xmi:id="_ah53_af3e028b2b92d796e2fb4036" name="sysMonitor_AMQP_IDD" xmi:type="uml:Class">
          <generalization xmi:id="_ah53_8c6bceff839547c9dc2bd24b" general="_ah53_e00d9088e2958ba26d766d9a" xmi:type="uml:Generalization" />
          <ownedComment xmi:id="_ah53_b06b23f407bfa38b8e2d291a" xmi:type="uml:Comment">
            <body>Source: ah5-EventHandler-java-spring/documentation/v5.3.0/EventHandler-v5.3.0-sysMonitor-AMQP-IDD.tex; With sysmonitor.enabled=true, EventHandler registers the service at start-up with interface template generic_amqps (protocol amqps, policy CERT_AUTH; generic_amqp without TLS) and the following properties and metadata:

\begin{lstlisting}[caption={Registered service instance (TestCloud).}]
{
  "serviceDefinitionName": "sysMonitor",
  "version": "1.0.0",
  "metadata": {
    "contract": "SysMonitor-AMQP-IDD-5.2.2",
    "schemaVersion": "1.0",
    "publisherMode": "native",
    "observationTypes": [
      "echo",
      "power",
      "status"
    ],
    "delivery": "persistent, publisher-confirmed"
  },
  "interfaces": [
    {
      "templateName": "generic_amqps",
      "protocol": "amqps",
      "policy": "CERT_AUTH",
      "properties": {
        "accessAddresses": [
          "amqp-broker"
        ],
        "accessPort": 5671,
        "exchange": "arrowhead",
        "baseRoutingKey": "TestCloud.sysmonitor.EventHandler.EventHandler",
        "operations": [
          "echo",
          "power",
          "status"
        ]
      }
    }
  ]
}
\end{lstlisting}</body>
          </ownedComment>
          <ownedOperation xmi:id="_ah53_ae731888a15cabdae1ee553b" name="echo" xmi:type="uml:Operation">
            <ownedComment xmi:id="_ah53_56a5b3e0ad4d3009c2546b5e" xmi:type="uml:Comment">
              <body>{"protocol": "amqp", "method": "PUBLISH", "address": "&lt;Cloud&gt;.sysmonitor.EventHandler.EventHandler.echo", "source": "ah5-EventHandler-java-spring/documentation/v5.3.0/EventHandler-v5.3.0-sysMonitor-AMQP-IDD.tex", "query": [], "path": [], "status": []}</body>
            </ownedComment>

        <packagedElement xmi:id="_ah53_a84926e7be4f76fe9164d78e" name="sysMonitor_SD" xmi:type="uml:Class" />
        <packagedElement xmi:id="_ah53_cf5d3c4fa4eec8127cf3878a" name="sysMonitor_AMQP_IDD" xmi:type="uml:Class">
          <generalization xmi:id="_ah53_32e2af5231ab2804a2339659" general="_ah53_a84926e7be4f76fe9164d78e" xmi:type="uml:Generalization" />
          <ownedComment xmi:id="_ah53_7609a815184e7f513c9097c4" xmi:type="uml:Comment">
            <body>Source: ah5-Onboarding-java-spring/documentation/v5.3.0/Onboarding-v5.3.0-sysMonitor-AMQP-IDD.tex; With sysmonitor.enabled=true, Onboarding registers the service at start-up with interface template generic_amqps (protocol amqps, policy CERT_AUTH; generic_amqp without TLS) and the following properties and metadata:

\begin{lstlisting}[caption={Registered service instance (TestCloud).}]
{
  "serviceDefinitionName": "sysMonitor",
  "version": "1.0.0",
  "metadata": {
    "contract": "SysMonitor-AMQP-IDD-5.2.2",
    "schemaVersion": "1.0",
    "publisherMode": "native",
    "observationTypes": [
      "echo",
      "power",
      "status"
    ],
    "delivery": "persistent, publisher-confirmed"
  },
  "interfaces": [
    {
      "templateName": "generic_amqps",
      "protocol": "amqps",
      "policy": "CERT_AUTH",
      "properties": {
        "accessAddresses": [
          "amqp-broker"
        ],
        "accessPort": 5671,
        "exchange": "arrowhead",
        "baseRoutingKey": "TestCloud.sysmonitor.Onboarding.Onboarding",
        "operations": [
          "echo",
          "power",
          "status"
        ]
      }
    }
  ]
}
\end{lstlisting}</body>
          </ownedComment>
          <ownedOperation xmi:id="_ah53_1ec65ebfce4b4aedc79651f9" name="echo" xmi:type="uml:Operation">

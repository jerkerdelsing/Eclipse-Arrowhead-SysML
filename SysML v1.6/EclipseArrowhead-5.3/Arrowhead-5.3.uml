verify &amp; GET &amp; \texttt{/token/verify/{token}} \\ \hline
get-public-key &amp; GET &amp; /public-key \\ \hline
register-encryption-key &amp; POST &amp; /encryption-key \\ \hline
unregister-encryption-key &amp; DELETE &amp; /encryption-key \\ \hline
\end{longtable}


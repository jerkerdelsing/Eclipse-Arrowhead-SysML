              <transition xmi:type="uml:Transition" xmi:id="_pellIIjEEfGvG8rPci7W4Q" name="IF image (EQ no animal AND location EQ Normal driving) THEN cameraConfig-1" source="_7Lp1EIjKEfGg5o1UyqpxGA" target="_FX4S4IR1EfGuqcglavX0DQ"/>
